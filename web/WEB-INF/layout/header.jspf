<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/header.css">

<div class="main-header">
    <div class="header-left">
        <a href="${pageContext.request.contextPath}/home" class="logo">
            M Y S H O P
        </a>
        
        <div class="category-menu-wrapper">
            <a href="${pageContext.request.contextPath}/listproduct" class="menu-btn" style="text-decoration: none">
    <i class="fa fa-bars"></i>
    <span>MENU</span>
</a>
            <ul class="category-dropdown">
                <c:if test="${not empty LIST_CATEGORY}">
                    <c:forEach var="c" items="${LIST_CATEGORY}">
                        <li>
                            <a href="${pageContext.request.contextPath}/listproduct?cid=${c.typeId}">
                                ${c.categoryName}
                            </a>
                        </li>
                    </c:forEach>
                </c:if>
            </ul>
        </div>
    </div>

    <div class="header-center">
        <form action="${pageContext.request.contextPath}/listproduct" method="get" class="search-form">
            <input type="text" name="keyword" placeholder="Bạn cần tìm gì?">
            <button type="submit" class="search-btn">
                <i class="fa fa-search"></i>
            </button>
        </form>
    </div>

    <div class="header-right">
        <c:choose>
            <c:when test="${sessionScope.account == null}">
                <a href="${pageContext.request.contextPath}/login" class="header-icon">
                    <i class="fa fa-shopping-cart"></i>
                    <span>Giỏ hàng</span>
                </a>
            </c:when>
            <c:otherwise>
                <a href="${pageContext.request.contextPath}/cart" class="header-icon">
                    <i class="fa fa-shopping-cart"></i>
                    <span>Giỏ hàng</span>
                </a>
            </c:otherwise>
        </c:choose>

        <c:choose>
            <c:when test="${sessionScope.account == null}">
                <a href="${pageContext.request.contextPath}/login" class="header-icon">
                    <i class="fa fa-user"></i>
                    <span>Đăng nhập</span>
                </a>
            </c:when>
            <c:otherwise>
                <div class="user-dropdown-wrapper">
                    <div class="user-info header-icon">
                        <i class="fa fa-user"></i>
                        <span class="user-name">
                            ${sessionScope.account.lastName} ${sessionScope.account.firstName}
                        </span>
                    </div>
                    <ul class="user-dropdown">
                        <li>
                            <a href="${pageContext.request.contextPath}/updateAccount?account=${sessionScope.account.account}">
                                Trang cá nhân
                            </a>
                        </li>
                        <c:choose>
                            <c:when test="${sessionScope.account.roleInSystem == 1 || sessionScope.account.roleInSystem == 2}">
                                <li>
                                    <a href="${pageContext.request.contextPath}/admin/listacc">Quản lý tài khoản</a>
                                </li>
                                <li>
                                    <a href="${pageContext.request.contextPath}/admin/products">Quản lý sản phẩm</a>
                                </li>
                                <li>
                                    <a href="${pageContext.request.contextPath}/listcategory">Quản lý danh mục</a>
                                </li>
                                <li>
                                    <a href="${pageContext.request.contextPath}/admin/orders">Quản lý đơn hàng</a>
                                </li>
                                <li>
                                    <a href="${pageContext.request.contextPath}/admin/user-segments">Phân khúc người dùng</a>
                                </li>
                            </c:when>
                            <c:otherwise>
                                <li>
                                    <a href="${pageContext.request.contextPath}/orders">Đơn hàng của tôi</a>
                                </li>
<!--                                <li>
                                    <a href="${pageContext.request.contextPath}/recently-viewed">Sản phẩm đã xem</a>
                                </li>-->
                            </c:otherwise>
                        </c:choose>
                        <li>
                            <a href="${pageContext.request.contextPath}/logout">Đăng xuất</a>
                        </li>
                    </ul>
                </div>
            </c:otherwise>
        </c:choose>
    </div>
</div>

<c:if test="${not empty sessionScope.ERROR_MSG}">
    <div style="background-color: #f8d7da; color: #721c24; padding: 10px 50px; text-align: center; border-bottom: 2px solid #f5c6cb;">
        ${sessionScope.ERROR_MSG}
        <c:remove var="ERROR_MSG" scope="session" />
    </div>
</c:if>
<c:if test="${not empty sessionScope.SUCCESS_MSG}">
    <div style="background-color: #d4edda; color: #155724; padding: 10px 50px; text-align: center; border-bottom: 2px solid #c3e6cb;">
        ${sessionScope.SUCCESS_MSG}
        <c:remove var="SUCCESS_MSG" scope="session" />
    </div>
</c:if>